{
  "name": "teacher-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "npm run lint && npm run build && npm run check:i18n && npm run test && npm run test:authz",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:authz": "python3 scripts/authz_tests.py",
    "test:e2e": "npm run build && node e2e/run.mjs",
    "test:bundle": "node scripts/check-bundle-size.mjs",
    "test:a11y": "npm run build && node scripts/a11y_audit.mjs",
    "test:perf": "npm run build && node scripts/perf_audit.mjs",
    "test:contracts": "node scripts/contract_tests.mjs",
    "test:ratelimits": "node scripts/rate_limit_checks.mjs",
    "test:faults": "node scripts/fault_injection.mjs",
    "test:mutation": "stryker run",
    "test:mailpit": "python3 scripts/mailpit_smoke.py"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-query": "^5.108.1",
    "@zxing/browser": "^0.2.1",
    "lucide-react": "^1.77.0",
    "papaparse": "^5.7.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "read-excel-file": "^9.3.20",
    "recharts": "^3.11.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "puppeteer": "^25.18.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
