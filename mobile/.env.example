# إعدادات بيئة — تُمرَّر عبر --dart-define في التشغيل/البناء (لا تُسلَّم قيم حقيقية للريبو).
# فيز 1: مشروع Supabase الديمو. الانتقال للبرودكشن = تغيير هذه القيم فقط.
SUPABASE_URL=https://YOUR-DEMO-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-DEMO-PUBLISHABLE-KEY
# المفتاح القابل للنشر فقط — لا service_role في أي عميل أبدًا.
