# انسخ الملف ده إلى .env واملأ القيم من مشروع Supabase بتاعك
# (Project Settings → API في لوحة Supabase)

# رابط المشروع — مثال: https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# مفتاح anon public — آمن للاستخدام في المتصفح لأن الحماية بـ RLS
VITE_SUPABASE_ANON_KEY=

# الدخول برقم الهاتف (كود واتساب — P5-3): اتركها false لحد اكتمال
# إعداد Meta عند المالك (WHATSAPP-OTP-DESIGN.md). true بتُظهر طريقة
# «برقم الهاتف» في صفحة الدخول جنب البريد.
VITE_WHATSAPP_OTP_ENABLED=false

# ملحوظة: من غير القيم دي التطبيق بيشتغل في وضع تجريبي بلا اتصال (واجهة فقط).
